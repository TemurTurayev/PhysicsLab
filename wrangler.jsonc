{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physicslab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // The site is static; only /api/* reaches the worker (accounts and saved progress).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "physicslab-db",
      "database_id": "0c681af6-9d59-4570-848b-fe23ae831e5f",
      "migrations_dir": "migrations"
    }
  ]
}
